# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM python:3.10-slim-bookworm AS builder

WORKDIR /build

# System deps for TensorFlow + wfdb
RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing \
    build-essential libhdf5-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --prefix=/install -r requirements.txt


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM python:3.10-slim-bookworm AS runtime

LABEL maintainer="cardiofusion"
LABEL description="CardioFusion AI Inference Service"

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY main.py .

# Copy model artefacts (must be generated by train.py first)
COPY artefacts/ ./artefacts/

# Non-root user for security
RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Healthcheck (Docker monitors this)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Production: gunicorn with uvicorn workers (4 workers default; tune via env)
CMD gunicorn main:app \
    --workers ${GUNICORN_WORKERS:-1} \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    --log-level info
